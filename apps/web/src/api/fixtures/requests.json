{
  "auth-session": {
    "method": "POST",
    "path": "/api/auth/session",
    "body": {
      "code": "oauth-code",
      "instanceId": "instance-1"
    }
  },
  "view-joined": {
    "method": "POST",
    "path": "/api/game/join",
    "body": {
      "role": "engineer",
      "offer": 1
    }
  },
  "view-built": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 4,
      "action": {
        "kind": "build",
        "unlock": "grappling-hook"
      }
    }
  },
  "view-moved": {
    "method": "POST",
    "path": "/api/game/move",
    "body": {
      "version": 5,
      "path": [
        {
          "kind": "hex",
          "hex": {
            "q": -2,
            "r": 2
          }
        }
      ]
    }
  },
  "view-next-day": {
    "method": "POST",
    "path": "/api/dev/next-day",
    "body": {}
  },
  "view-surveyed": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 7,
      "action": {
        "kind": "survey",
        "hex": {
          "q": -2,
          "r": 1
        }
      }
    }
  },
  "view-replaced": {
    "method": "POST",
    "path": "/api/game/replace",
    "body": {
      "role": "envoy",
      "offer": 2
    }
  },
  "view-foraged": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 4,
      "action": {
        "kind": "gather"
      }
    }
  },
  "view-fire-lit": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 5,
      "action": {
        "kind": "light-fire"
      }
    }
  },
  "view-fed": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 7,
      "action": {
        "kind": "feed"
      }
    }
  },
  "view-lingered": {
    "method": "POST",
    "path": "/api/game/act",
    "body": {
      "version": 8,
      "action": {
        "kind": "linger"
      }
    }
  },
  "view-keeper-cue": {
    "method": "POST",
    "path": "/api/dev/next-day",
    "body": {}
  }
}
