{
  "name": "@behemoth-road/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('node:fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "typecheck": "pnpm types && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm types && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run && node --test 'scripts/*.test.mjs'",
    "fixtures:capture": "node scripts/capture-fixtures.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@behemoth-road/core": "workspace:*",
    "valibot": "catalog:"
  }
}
